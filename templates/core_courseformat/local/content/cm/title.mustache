{{!
    @template theme_citricityxund/core_courseformat/local/content/cm/title

    Theme override of core_courseformat/local/content/cm/title.

    Wraps the module-type suffix (altname) in .activity-type-label and moves
    it in front of the activity name, so the theme can surface it as the
    visible type label above the name. The localised type only reaches this
    template pre-wrapped in core's accesshide span (the str helper cannot
    resolve a component computed from modname), so the label is unhidden in
    CSS rather than re-resolved here.

    Example context (json):
    {
        "url": "#",
        "instancename": "Activity name",
        "uservisible": true,
        "onclick": "alert('ok')",
        "altname": "PDF file",
        "linkclasses": "",
        "modname": "resource"
    }
}}
{{#uservisible}}
    <a href="{{url}}" class="{{linkclasses}} aalink stretched-link" onclick="{{{onclick}}}">
        {{#altname}}<span class="activity-type-label">{{{altname}}}</span>{{/altname}}
        <span class="instancename">{{{instancename}}}</span>
    </a>
{{/uservisible}}
{{^uservisible}}
    {{#altname}}<span class="activity-type-label">{{{altname}}}</span>{{/altname}}
    <span class="instancename">
        {{{instancename}}}
    </span>
{{/uservisible}}
